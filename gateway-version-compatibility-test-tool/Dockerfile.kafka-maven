# Test client image: JDK 11 + Maven for the JUnit suites. The Kafka client under test comes
# from Maven (-Dkafka.version), not from this image, so one image serves every client version.
# (It used to extend cp-kafka:<client version>; from CP 8.3 those images have no package
# manager to install a JDK and Maven with.)
FROM maven:3.9.9-eclipse-temurin-11

# Run as an unprivileged user, not the base image's root: the tests only need to read the
# project copied into /tmp and the mounted certificates, and write the report directories and
# their own Maven repository (MAVEN_CONFIG, which the base image points at /root/.m2).
RUN useradd --create-home --uid 10001 tester \
    && mkdir -p /junit-results /html-results \
    && chown tester:tester /junit-results /html-results
ENV MAVEN_CONFIG=/home/tester/.m2
USER tester

WORKDIR /tmp

# Default command
CMD ["sh", "-c", "sleep infinity"]
