# Test client image: JDK 11 + Maven for the JUnit suites. The Kafka client under test comes
# from Maven (-Dkafka.version), not from this image, so one image serves every client version.
# (It used to extend cp-kafka:<client version>; from CP 8.3 those images have no package
# manager to install a JDK and Maven with.)
FROM maven:3.9.9-eclipse-temurin-11

# Create directories for test results
RUN mkdir -p /junit-results /html-results

WORKDIR /tmp

# Default command
CMD ["sh", "-c", "sleep infinity"]
